#!/usr/bin/env python3
"""ccstatusline widget: agent label (envoak/dawn) + session start time.

  cc-agent-session            statusline segment: "<agent> · <start>"
  cc-agent-session --title    same + repo, written to /dev/tty as the terminal
                              window title (for a SessionStart/UserPromptSubmit hook)

Context % is already covered by ccstatusline's built-in context widgets.
"""
import glob
import json
import os
import re
import sys
from datetime import datetime

HOME = os.path.expanduser('~')
sid = os.environ.get('CLAUDE_CODE_SESSION_ID', '')


def agent():
    # session-scoped identity (written by dawn) wins over the shared one
    paths = [f'{HOME}/.envoak/session-identity/{sid}.env' if sid else None,
             f'{HOME}/.envoak/current-identity.env']
    for p in paths:
        if not p or not os.path.exists(p):
            continue
        m = re.search(r'ENVOAK_AGENT_LABEL="?([^"\n]+)', open(p).read())
        if m:
            return m.group(1)
    return os.environ.get('TOAK_AGENT_ID', '?')


def started():
    hits = glob.glob(f'{HOME}/.claude/projects/*/{sid}.jsonl') if sid else []
    if not hits:
        return None
    with open(hits[0], errors='ignore') as f:
        for line in f:
            try:
                ts = json.loads(line).get('timestamp')
            except Exception:
                continue
            if ts:
                # stored UTC ("...Z"); show local
                utc = datetime.fromisoformat(ts.replace('Z', '+00:00'))
                return utc.astimezone().strftime('%b%d %H:%M')
    return None


def pinned():
    """📌 when ccsessions/tbe has this session frozen — same file `tbe freeze` writes."""
    try:
        with open(f'{HOME}/.claude/ccsessions-frozen.json') as f:
            return sid in json.load(f)
    except Exception:
        return False


def repo():
    """Nearest enclosing git repo name, else the cwd's name."""
    d = os.getcwd()
    while True:
        if os.path.exists(os.path.join(d, '.git')):
            return os.path.basename(d)
        parent = os.path.dirname(d)
        if parent == d:
            return os.path.basename(os.getcwd())
        d = parent


def waiting():
    """💡 when memosan has a proactive recall queued. Passive: the statusline shows
    that the librarian has something, instead of a hook shoving it into context."""
    try:
        return os.path.getsize(f'{HOME}/.memosan/proactive-inbox.md') > 0
    except OSError:
        return False


def render(with_repo):
    parts = [agent()] + ([repo()] if with_repo else [])
    t = started()
    if t:
        parts.append(t)
    line = ' · '.join(parts)
    if pinned():
        line = f'📌 {line}'
    return f'{line} 💡' if waiting() else line


def set_title():
    """Hook/widget stdout goes to Claude Code, so talk to the terminal directly.
    CC_TITLE_TTY redirects it to a file — handy to see what would be written."""
    try:
        with open(os.environ.get('CC_TITLE_TTY', '/dev/tty'), 'w') as tty:
            tty.write(f'\033]0;{render(with_repo=True)}\007')
    except Exception:
        pass


if '--title' in sys.argv[1:]:
    set_title()
else:
    print(render(with_repo=False))
    # NOT setting the title here by default: a widget write to /dev/tty lands in the
    # middle of the TUI's own frame and shreds multi-byte glyphs into "�". Opt in with
    # CC_AGENT_SESSION_TITLE=1 if your terminal tolerates it; the hook is the safe path.
    if os.environ.get('CC_AGENT_SESSION_TITLE') == '1':
        set_title()
