#!/usr/bin/env python3
"""Statusline widget: short session id (#a28 = first 3 chars of the session id).
Stable and typable — `tbe resume a28` resumes exactly this session. The old
mtime-rank number was always #1: your own transcript is the freshest file at
the moment your statusline renders."""
import os
sid = os.environ.get('CLAUDE_CODE_SESSION_ID', '')
if sid:
    print(f'#{sid[:3]}')
