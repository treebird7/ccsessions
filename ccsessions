#!/usr/bin/env python3
"""ccsessions — list Claude Code sessions (project, what it's doing) and resume one.

Usage:
  ccsessions            # 30 most-recent sessions, pick a number to resume
  ccsessions -n 60      # show more
  ccsessions -a         # show all
  ccsessions foo        # filter by project/tldr substring
  ccsessions -g         # group by project (cockpit view)
  ccsessions --json     # machine-readable dump (for birdsan orchestration)
  tbe freeze [N] [note] # pin a session for later (no N = current session)
  tbe thaw <#|id>       # unpin
"""
import os, sys, json, glob, subprocess, time

PROJECTS = os.path.expanduser("~/.claude/projects")
FROZEN = os.path.expanduser("~/.claude/ccsessions-frozen.json")  # {id: {note, at, proj}}
LAST = os.path.expanduser("~/.claude/ccsessions-last.json")      # [{n,id,proj,cwd}] of last render

def load_json(p, default):
    try:
        with open(p) as fh: return json.load(fh)
    except Exception:
        return default

def save_json(p, data):
    try:
        with open(p, "w") as fh: json.dump(data, fh)
    except Exception:
        pass

def first(d, *keys):
    for k in keys:
        if k in d and d[k]:
            return d[k]
    return None

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):  # blocks
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
        return " ".join(str(b.get("text","")) for b in content if isinstance(b, dict))
    return ""

def noisy(t):
    return (t.startswith("<") or
            t.startswith("Base directory for this skill") or
            t.startswith("Caveat:") or "<command-" in t[:40])

def scan(path):
    """Return (cwd, tldr, doing) — tldr is the gist, doing is the LATEST activity."""
    cwd, summary, first_user = None, None, None
    try:
        with open(path, "r", errors="ignore") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                cwd = cwd or d.get("cwd")
                if d.get("type") == "summary" and not summary:
                    summary = d.get("summary")
                if first_user is None and d.get("type") == "user":
                    msg = d.get("message") or {}
                    if msg.get("role") == "user":
                        t = text_of(msg.get("content")).strip()
                        if t and not noisy(t):
                            first_user = t
                if cwd and summary:
                    break
    except Exception:
        pass
    tldr = summary or first_user or "(no preview)"
    return cwd, " ".join(tldr.split()), last_doing(path)

def last_doing(path, nbytes=65536):
    """Tail the file for the most recent meaningful user/assistant text — the
    freshest 'what it's doing now', truer than a stale hive signal.
    ponytail: 64KB tail, not a full read; bump if last turns are huge."""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as fh:
            if sz > nbytes:
                fh.seek(-nbytes, os.SEEK_END); fh.readline()
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except Exception:
        return ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") in ("user", "assistant"):
            t = text_of((d.get("message") or {}).get("content")).strip()
            if t and not noisy(t):
                return " ".join(t.split())[:200]
    return ""

def running_cwds():
    try:
        pids = subprocess.check_output(["pgrep", "-x", "claude"], text=True).split()
    except Exception:
        return set()
    out = set()
    for p in pids:
        try:
            r = subprocess.check_output(["lsof","-a","-p",p,"-d","cwd","-Fn"], text=True, stderr=subprocess.DEVNULL)
            for l in r.splitlines():
                if l.startswith("n"):
                    out.add(l[1:])
        except Exception:
            pass
    return out

def find_file(sid):
    g = glob.glob(os.path.join(PROJECTS, "*", f"*{sid}*.jsonl"))
    return g[0] if g else None

def row_for(sid, live):
    """Build a row for a session id (may be older than the scan window)."""
    f = find_file(sid)
    if not f:
        return None
    cwd, tldr, doing = scan(f)
    proj = os.path.basename(cwd) if cwd else os.path.basename(os.path.dirname(f))
    return {"id": os.path.basename(f)[:-6], "cwd": cwd, "proj": proj, "tldr": tldr,
            "doing": doing, "mtime": os.path.getmtime(f), "live": cwd in live}

def cmd_freeze(rest):
    """tbe freeze [N] [note...]  — pin a session for later with an optional note.
    N resolves against the last listing; with no N, freezes the CURRENT session."""
    frozen = load_json(FROZEN, {})
    sid, proj = None, None
    if rest and rest[0].isdigit():
        n = int(rest[0]); rest = rest[1:]
        row = next((r for r in load_json(LAST, []) if r["n"] == n), None)
        if not row:
            print(f"no #{n} in the last listing — run `tbe` first, then freeze."); return
        sid, proj = row["id"], row.get("proj")
    else:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        if not sid:
            print("not inside a session — use: tbe freeze <#> [note]"); return
    frozen[sid] = {"note": " ".join(rest), "at": time.time(), "proj": proj}
    save_json(FROZEN, frozen)
    print(f"📌 frozen {sid[:8]} — {frozen[sid]['note'] or '(no note)'}")

def cmd_thaw(rest):
    frozen = load_json(FROZEN, {})
    if not rest:
        print("usage: tbe thaw <#|id>"); return
    key = rest[0]
    sid = None
    if key.isdigit():
        row = next((r for r in load_json(LAST, []) if r["n"] == int(key)), None)
        sid = row["id"] if row else None
    else:
        sid = next((k for k in frozen if k.startswith(key)), key)
    if sid in frozen:
        del frozen[sid]; save_json(FROZEN, frozen); print(f"🫧 thawed {sid[:8]}")
    else:
        print(f"not frozen: {key}")

def print_pinned(rows, ago, frozen, start=0):
    """Render the 📌 frozen section at the very top. Returns rows in print order."""
    if not rows:
        return []
    print(f"\n\033[1;35m📌 frozen\033[0m \033[2m({len(rows)})\033[0m")
    out, i = [], start
    for r in rows:
        i += 1; out.append(r)
        dot = "\033[32m●\033[0m" if r["live"] else " "
        note = frozen.get(r["id"], {}).get("note") or (r["doing"] or r["tldr"])
        print(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  \033[35m{r['proj'][:14]:<14}\033[0m {note[:50]}")
    print()
    return out

def print_grouped(rows, ago, start=0):
    """Cockpit view: sessions bucketed by project, freshest project first.
    Returns rows in printed order so resume-by-number still lines up."""
    groups = {}
    for r in rows:
        groups.setdefault(r["proj"] or "?", []).append(r)
    order = sorted(groups, key=lambda p: max(x["mtime"] for x in groups[p]), reverse=True)
    out, i = [], start
    print()
    for proj in order:
        g = sorted(groups[proj], key=lambda x: x["mtime"], reverse=True)
        n_live = sum(1 for x in g if x["live"])
        flag = f" \033[32m{n_live} live\033[0m" if n_live else ""
        print(f"\033[1;36m{proj}\033[0m  \033[2m({len(g)}){flag}\033[0m")
        for r in g:
            i += 1; out.append(r)
            dot = "\033[32m●\033[0m" if r["live"] else " "
            line = (r["doing"] or r["tldr"])[:64]
            print(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  {line}")
        print()
    print(f"  \033[32m●\033[0m = running   ({len(out)} sessions, {len(order)} projects)")
    return out

def main():
    args = sys.argv[1:]
    if args and args[0] == "freeze": return cmd_freeze(args[1:])
    if args and args[0] == "thaw":   return cmd_thaw(args[1:])
    limit, filt = 30, None
    as_json = "--json" in args; args = [a for a in args if a != "--json"]
    # Invoked as `tbe` (TreeBirdsEye) → grouped cockpit by default.
    grouped = "-g" in args or os.path.basename(sys.argv[0]).startswith("tbe")
    args = [a for a in args if a != "-g"]
    if as_json: limit = 10**9
    if "-a" in args: limit = 10**9; args.remove("-a")
    if "-n" in args:
        i = args.index("-n"); limit = int(args[i+1]); del args[i:i+2]
    if args: filt = args[0].lower()

    files = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)

    live = running_cwds()
    rows = []
    for f in files:
        cwd, tldr, doing = scan(f)
        proj = os.path.basename(cwd) if cwd else os.path.basename(os.path.dirname(f))
        if filt and filt not in proj.lower() and filt not in tldr.lower() and filt not in doing.lower():
            continue
        rows.append({
            "id": os.path.basename(f)[:-6], "cwd": cwd, "proj": proj, "tldr": tldr,
            "doing": doing, "mtime": os.path.getmtime(f), "live": cwd in live,
        })
        if len(rows) >= limit:
            break

    if not rows:
        print("No sessions found." if not as_json else "[]"); return

    now = time.time()
    def ago(t):
        s = now - t
        if s < 3600: return f"{int(s//60)}m"
        if s < 86400: return f"{int(s//3600)}h"
        return f"{int(s//86400)}d"

    # Frozen sessions are pinned to the top, always shown even if older than the
    # scan window — fetch any that the scan missed, and pull pinned out of the body.
    frozen = load_json(FROZEN, {})
    pinned_ids = [s for s in rows if s["id"] in frozen]
    have = {r["id"] for r in pinned_ids}
    for sid in frozen:
        if sid not in have:
            r = row_for(sid, live)
            if r: pinned_ids.append(r)
    pinned_ids.sort(key=lambda r: frozen.get(r["id"], {}).get("at", 0), reverse=True)
    rows = [r for r in rows if r["id"] not in frozen]

    if as_json:
        for r in rows + pinned_ids:
            r["ago"] = ago(r["mtime"]); r["frozen"] = r["id"] in frozen
        print(json.dumps(pinned_ids + rows, indent=2)); return

    pinned = print_pinned(pinned_ids, ago, frozen)
    if grouped:
        body = print_grouped(rows, ago, start=len(pinned))
    else:
        body = []
        print()
        for i, r in enumerate(rows, len(pinned) + 1):
            body.append(r)
            dot = "\033[32m●\033[0m" if r["live"] else " "
            proj = (r["proj"] or "?")[:22]
            line = (r["doing"] or r["tldr"])[:70]
            print(f" {dot} \033[1m{i:>3}\033[0m  \033[36m{proj:<22}\033[0m {ago(r['mtime']):>4}  {line}")
        print(f"\n  \033[32m●\033[0m = running   ({len(rows)} shown)")
    rows = pinned + body
    save_json(LAST, [{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"]}
                     for i, r in enumerate(rows, 1)])

    try:
        pick = input("\nResume # (Enter to quit): ").strip()
    except (EOFError, KeyboardInterrupt):
        print(); return
    if not pick:
        return
    try:
        r = rows[int(pick) - 1]
    except (ValueError, IndexError):
        print("invalid"); return
    if not r["cwd"] or not os.path.isdir(r["cwd"]):
        print(f"cwd missing: {r['cwd']}"); return
    os.chdir(r["cwd"])
    os.execvp("claude", ["claude", "--resume", r["id"], "--dangerously-skip-permissions"])

if __name__ == "__main__":
    main()
