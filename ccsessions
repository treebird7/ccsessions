#!/usr/bin/env python3
"""ccsessions — list Claude Code sessions (project, what it's doing) and resume one.

Usage:
  ccsessions            # 100 most-recent sessions (set CCSESSIONS_LIMIT to change)
  ccsessions -n 200     # show a custom count
  ccsessions -a         # show all
  ccsessions foo        # filter by project/tldr substring
  ccsessions -g         # group by project (cockpit view)
  ccsessions --json     # machine-readable dump (for birdsan orchestration)
  tbe freeze [N] [note] # pin a session for later (no N = current session)
  tbe thaw <#|id>       # unpin
  tbe closed [N] [note] # mark a session closed — moves it to the (c) section
  tbe reopen <#|id>     # un-close
  tbe resume <#|id> [-p "prompt"]  # resume a session; with -p, headless (agent-safe)

Interactive keys: number = resume, m = next 100 sessions, c = toggle closed
section, s = search (project/tldr/doing/agent substring; empty query clears).
"""
import os, sys, json, glob, subprocess, time, re
from collections import Counter
from datetime import datetime

PROJECTS = os.path.expanduser("~/.claude/projects")
SESSION_IDENTITY = os.path.expanduser("~/.envoak/session-identity")  # dawn writes <sid>.env
FROZEN = os.path.expanduser("~/.claude/ccsessions-frozen.json")  # {id: {note, at, proj}}
CLOSED = os.path.expanduser("~/.claude/ccsessions-closed.json")  # {id: {note, at, proj}}
LAST = os.path.expanduser("~/.claude/ccsessions-last.json")      # [{n,id,proj,cwd}] of last render

def load_json(p, default):
    try:
        with open(p) as fh: return json.load(fh)
    except Exception:
        return default

def save_json(p, data):
    try:
        with open(p, "w") as fh: json.dump(data, fh)
    except Exception:
        pass

def first(d, *keys):
    for k in keys:
        if k in d and d[k]:
            return d[k]
    return None

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):  # blocks
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
        return " ".join(str(b.get("text","")) for b in content if isinstance(b, dict))
    return ""

def noisy(t):
    return (t.startswith("<") or
            t.startswith("Base directory for this skill") or
            t.startswith("Caveat:") or "<command-" in t[:40])

def agent_of(sid):
    """Agent label dawn pinned to this session, '' if the session never ran dawn.
    Only the per-session file — the shared current-identity.env would stamp the
    SAME label on every row, which is worse than blank."""
    try:
        with open(os.path.join(SESSION_IDENTITY, f"{sid}.env")) as fh:
            m = re.search(r'ENVOAK_AGENT_LABEL="?([^"\n]+)', fh.read())
            return m.group(1) if m else ""
    except Exception:
        return ""

def when(iso):
    """'2026-07-31T13:36:02.123Z' → local 'Jul31 13:36'."""
    if not iso:
        return ""
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%b%d %H:%M")
    except Exception:
        return ""

def scan(path):
    """Return (cwd, tldr, doing, started) — tldr is the gist, doing is the LATEST
    activity, started is the first timestamp in the transcript (session birth)."""
    cwd, summary, first_user, started = None, None, None, None
    try:
        with open(path, "r", errors="ignore") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                cwd = cwd or d.get("cwd")
                started = started or d.get("timestamp")
                if d.get("type") == "summary" and not summary:
                    summary = d.get("summary")
                if first_user is None and d.get("type") == "user":
                    msg = d.get("message") or {}
                    if msg.get("role") == "user":
                        t = text_of(msg.get("content")).strip()
                        if t and not noisy(t):
                            first_user = t
                if cwd and summary and started:
                    break
    except Exception:
        pass
    tldr = summary or first_user or "(no preview)"
    return cwd, " ".join(tldr.split()), last_doing(path), started

def last_paragraph(t):
    """Final paragraph of a message — the conclusion/next-step, which is what you
    need when deciding whether to resume. Skips trailing code fences."""
    paras = [p.strip() for p in re.split(r"\n\s*\n", t) if p.strip()]
    while paras and paras[-1].startswith("```"):
        paras.pop()
    return paras[-1] if paras else t

def last_doing(path, nbytes=65536):
    """Tail the file for the LAST PARAGRAPH of the most recent meaningful
    user/assistant message — the freshest 'where this left off'.
    ponytail: 64KB tail, not a full read; bump if last turns are huge."""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as fh:
            if sz > nbytes:
                fh.seek(-nbytes, os.SEEK_END); fh.readline()
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except Exception:
        return ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") in ("user", "assistant"):
            t = text_of((d.get("message") or {}).get("content")).strip()
            if t and not noisy(t):
                return " ".join(last_paragraph(t).split())[:200]
    return ""

def _proc_cwd(pid):
    try:
        r = subprocess.check_output(["lsof","-a","-p",pid,"-d","cwd","-Fn"], text=True, stderr=subprocess.DEVNULL)
        return next((l[1:] for l in r.splitlines() if l.startswith("n")), None)
    except Exception:
        return None

def running_sessions():
    """Set of session ids that are ACTUALLY running — one per live `claude` process.
    `--resume <id>` in argv pins the id exactly; a fresh start (no --resume) writes the
    newest jsonl in its cwd's project dir, so K procs in a cwd claim the K newest unclaimed
    sessions there. Far truer than the old per-cwd flag, which lit up every session that
    ever ran in a live folder (closed, ancient, all green).
    ponytail: argv + newest-mtime heuristic; exact for --resume, newest-jsonl for fresh."""
    try:
        pids = subprocess.check_output(["pgrep", "-x", "claude"], text=True).split()
    except Exception:
        return set()
    live, fresh_cwds = set(), []
    for p in pids:
        try:
            args = subprocess.check_output(["ps","-o","args=","-p",p], text=True)
        except Exception:
            args = ""
        m = re.search(r"--resume\s+([0-9a-fA-F-]{36})", args)
        if m:
            live.add(m.group(1)); continue
        cwd = _proc_cwd(p)
        if cwd:
            fresh_cwds.append(cwd)
    # fresh starts: each takes the newest not-yet-claimed jsonl in its cwd's project dir.
    # A fresh `claude` is writing RIGHT NOW, so only recently-touched files qualify — this
    # stops a surplus proc (e.g. a child/zombie) from lighting up an ancient session.
    cutoff = time.time() - 2 * 3600
    for cwd, k in Counter(fresh_cwds).items():
        pdir = os.path.join(PROJECTS, cwd.replace("/", "-"))
        js = sorted(glob.glob(os.path.join(pdir, "*.jsonl")), key=os.path.getmtime, reverse=True)
        for f in js:
            if k <= 0: break
            if os.path.getmtime(f) < cutoff: break
            sid = os.path.basename(f)[:-6]
            if sid not in live:
                live.add(sid); k -= 1
    return live

def find_file(sid):
    """Prefix match first (statusline short ids are id prefixes), substring as
    fallback; newest wins on collision — 3 hex chars can repeat across history."""
    g = (glob.glob(os.path.join(PROJECTS, "*", f"{sid}*.jsonl")) or
         glob.glob(os.path.join(PROJECTS, "*", f"*{sid}*.jsonl")))
    return max(g, key=os.path.getmtime) if g else None

def row_for(sid, live):
    """Build a row for a session id (may be older than the scan window)."""
    f = find_file(sid)
    if not f:
        return None
    cwd, tldr, doing, started = scan(f)
    proj = os.path.basename(cwd) if cwd else os.path.basename(os.path.dirname(f))
    sid = os.path.basename(f)[:-6]
    return {"id": sid, "cwd": cwd, "proj": proj, "tldr": tldr, "doing": doing,
            "mtime": os.path.getmtime(f), "live": sid in live,
            "started": started, "agent": agent_of(sid)}

def _resolve_sid(rest, verb):
    """(sid, proj, remaining-args). Leading number resolves against the last
    listing; no number = the CURRENT session ($CLAUDE_CODE_SESSION_ID)."""
    if rest and rest[0].isdigit():
        n = int(rest[0])
        row = next((r for r in load_json(LAST, []) if r["n"] == n), None)
        if not row:
            print(f"no #{n} in the last listing — run `tbe` first, then {verb}.")
            return None, None, rest[1:]
        return row["id"], row.get("proj"), rest[1:]
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print(f"not inside a session — use: tbe {verb} <#> [note]")
    return sid, None, rest

def _mark(path, rest, verb, emoji):
    """Shared body of freeze/closed: stamp {note, at, proj} for a session."""
    sid, proj, rest = _resolve_sid(rest, verb)
    if not sid:
        return
    marks = load_json(path, {})
    marks[sid] = {"note": " ".join(rest), "at": time.time(), "proj": proj}
    save_json(path, marks)
    print(f"{emoji} {verb} {sid[:8]} — {marks[sid]['note'] or '(no note)'}")

def _unmark(path, rest, verb, emoji, done, noun):
    marks = load_json(path, {})
    if not rest:
        print(f"usage: tbe {verb} <#|id>"); return
    key = rest[0]
    if key.isdigit():
        row = next((r for r in load_json(LAST, []) if r["n"] == int(key)), None)
        sid = row["id"] if row else None
    else:
        sid = next((k for k in marks if k.startswith(key)), key)
    if sid in marks:
        del marks[sid]; save_json(path, marks); print(f"{emoji} {done} {sid[:8]}")
    else:
        print(f"not {noun}: {key}")

def cmd_resume(rest):
    """tbe resume <#|id> [-p "prompt"] — resume a session by number (from the
    last listing) or id prefix. With -p, runs `claude -p --resume` headless —
    no TTY needed, so agents can call this from a Bash tool. Without -p,
    execs the interactive TUI exactly like the picker."""
    prompt = None
    if "-p" in rest:
        i = rest.index("-p")
        prompt = " ".join(rest[i + 1:])
        rest = rest[:i]
        if not prompt:
            print("empty -p prompt"); return 2
    if not rest:
        print('usage: tbe resume <#|id> [-p "prompt"]'); return 2
    key = rest[0]
    if key.isdigit():
        row = next((r for r in load_json(LAST, []) if r["n"] == int(key)), None)
        if not row:
            print(f"no #{key} in the last listing — run `tbe` first."); return 2
        sid, cwd = row["id"], row.get("cwd")
    else:
        f = find_file(key)
        if not f:
            print(f"no session matching: {key}"); return 2
        sid, cwd = os.path.basename(f)[:-6], scan(f)[0]
    if not cwd or not os.path.isdir(cwd):
        print(f"cwd missing: {cwd}"); return 2
    os.chdir(cwd)
    if prompt:
        return subprocess.call(["claude", "-p", "--resume", sid,
                                "--dangerously-skip-permissions", prompt])
    os.execvp("claude", ["claude", "--resume", sid, "--dangerously-skip-permissions"])

def cmd_freeze(rest): _mark(FROZEN, rest, "freeze", "📌")
def cmd_thaw(rest):   _unmark(FROZEN, rest, "thaw", "🫧", "thawed", "frozen")
def cmd_closed(rest): _mark(CLOSED, rest, "closed", "🌙")
def cmd_reopen(rest): _unmark(CLOSED, rest, "reopen", "🌤", "reopened", "closed")

def meta(r, w_agent):
    """short-id + agent + session-start columns. The short id (first 3 chars of
    the session id) matches the statusline's #a28 and feeds `tbe resume a28`.
    w_agent=0 drops the agent column entirely (nothing in this listing ran
    dawn), so we don't pay 10 blank chars a row."""
    a = f"\033[36m{(r.get('agent') or '')[:w_agent]:<{w_agent}}\033[0m " if w_agent else ""
    return f"\033[2m{r['id'][:3]}\033[0m {a}\033[2m{when(r.get('started')):<11}\033[0m"

def agent_width(rows, cap=12):  # fits the longest real label, e.g. "spidersan-m5"
    w = max((len(r.get("agent") or "") for r in rows), default=0)
    return min(w, cap)

def print_pinned(rows, ago, frozen, start=0, w_agent=0):
    """Render the 📌 frozen section at the very top. Returns rows in print order."""
    if not rows:
        return []
    print(f"\n\033[1;35m📌 frozen\033[0m \033[2m({len(rows)})\033[0m")
    out, i = [], start
    for r in rows:
        i += 1; out.append(r)
        dot = "\033[32m●\033[0m" if r["live"] else " "
        note = frozen.get(r["id"], {}).get("note") or (r["doing"] or r["tldr"])
        print(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  \033[35m{r['proj'][:14]:<14}\033[0m "
              f"{meta(r, w_agent)}  {note[:44]}")
    print()
    return out

def print_grouped(rows, ago, start=0, w_agent=0):
    """Cockpit view: sessions bucketed by project, freshest project first.
    Returns rows in printed order so resume-by-number still lines up."""
    groups = {}
    for r in rows:
        groups.setdefault(r["proj"] or "?", []).append(r)
    order = sorted(groups, key=lambda p: max(x["mtime"] for x in groups[p]), reverse=True)
    out, i = [], start
    print()
    for proj in order:
        g = sorted(groups[proj], key=lambda x: x["mtime"], reverse=True)
        n_live = sum(1 for x in g if x["live"])
        flag = f" \033[32m{n_live} live\033[0m" if n_live else ""
        print(f"\033[1;36m{proj}\033[0m  \033[2m({len(g)}){flag}\033[0m")
        for r in g:
            i += 1; out.append(r)
            dot = "\033[32m●\033[0m" if r["live"] else " "
            line = (r["doing"] or r["tldr"])[:58]
            print(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  {meta(r, w_agent)}  {line}")
        print()
    print(f"  \033[32m●\033[0m = running   ({len(out)} sessions, {len(order)} projects)")
    return out

def _selftest():
    # the two load-bearing bits of running_sessions(): --resume id capture + cwd→projdir encoding
    rid = "246effba-e0d4-4fa1-be5e-7411e403eadb"
    m = re.search(r"--resume\s+([0-9a-fA-F-]{36})", f"claude --resume {rid} --dangerously-skip-permissions")
    assert m and m.group(1) == rid, "resume regex"
    assert "/Users/freedbird/Dev/Envoak".replace("/", "-") == "-Users-freedbird-Dev-Envoak", "projdir encoding"
    # UTC transcript stamps must land in local time, and a missing one must not blow up
    os.environ["TZ"] = "UTC"; time.tzset()
    assert when("2026-07-31T13:36:02.123Z") == "Jul31 13:36", "timestamp format"
    assert when(None) == "" and when("garbage") == "", "timestamp fallbacks"
    assert agent_of("no-such-session-id") == "", "agent fallback"
    assert agent_width([{"agent": "sherlock-m5"}, {"agent": ""}]) == 11, "agent column width"
    assert agent_width([{"agent": ""}]) == 0, "agent column hidden when unused"
    # last_paragraph: conclusion wins, trailing code fence skipped, plain text intact
    msg = "Idea good, half exists.\n\nMiddle detail.\n\nWant me build it? Piece 2+3 in repo."
    assert last_paragraph(msg) == "Want me build it? Piece 2+3 in repo.", "last paragraph"
    assert last_paragraph("Fix:\n\n```py\nx=1\n```") == "Fix:", "code fence skipped"
    assert last_paragraph("one liner") == "one liner", "single paragraph"
    print("selftest ok"); return

def main():
    args = sys.argv[1:]
    if args and args[0] == "--selftest": return _selftest()
    if args and args[0] == "freeze": return cmd_freeze(args[1:])
    if args and args[0] == "thaw":   return cmd_thaw(args[1:])
    if args and args[0] == "closed": return cmd_closed(args[1:])
    if args and args[0] == "reopen": return cmd_reopen(args[1:])
    if args and args[0] == "resume": return cmd_resume(args[1:])
    limit, filt = int(os.environ.get("CCSESSIONS_LIMIT", "100")), None
    as_json = "--json" in args; args = [a for a in args if a != "--json"]
    # Invoked as `tbe` (TreeBirdsEye) → grouped cockpit by default.
    grouped = "-g" in args or os.path.basename(sys.argv[0]).startswith("tbe")
    args = [a for a in args if a != "-g"]
    if as_json: limit = 10**9
    if "-a" in args: limit = 10**9; args.remove("-a")
    if "-n" in args:
        i = args.index("-n"); limit = int(args[i+1]); del args[i:i+2]
    if args: filt = args[0].lower()

    files = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)

    frozen = load_json(FROZEN, {})
    closed = load_json(CLOSED, {})
    live = running_sessions()
    rows, fiter = [], iter(files)

    def take(k):
        """Scan the next k matching sessions into rows. Closed sessions are
        skipped here — they live in the (c) section (frozen outranks closed)."""
        for f in fiter:
            if k <= 0:
                return
            sid = os.path.basename(f)[:-6]
            if sid in closed and sid not in frozen:
                continue
            cwd, tldr, doing, started = scan(f)
            proj = os.path.basename(cwd) if cwd else os.path.basename(os.path.dirname(f))
            agent = agent_of(sid)
            if filt and not any(filt in s.lower() for s in (proj, tldr, doing, agent)):
                continue
            rows.append({
                "id": sid, "cwd": cwd, "proj": proj, "tldr": tldr,
                "doing": doing, "mtime": os.path.getmtime(f), "live": sid in live,
                "started": started, "agent": agent,
            })
            k -= 1

    take(limit)

    now = time.time()
    def ago(t):
        s = now - t
        if s < 3600: return f"{int(s//60)}m"
        if s < 86400: return f"{int(s//3600)}h"
        return f"{int(s//86400)}d"

    def closed_rows():
        """Rows for every closed session, newest first. The close note (why it
        ended) wins over the transcript tail when present."""
        out = []
        for sid, mark in closed.items():
            if sid in frozen:
                continue
            r = row_for(sid, live)
            if r:
                if mark.get("note"):
                    r["doing"] = mark["note"]
                if filt and not any(filt in (r.get(k) or "").lower()
                                    for k in ("proj", "tldr", "doing", "agent")):
                    continue
                out.append(r)
        out.sort(key=lambda r: r["mtime"], reverse=True)
        return out

    def pinned_rows():
        """Frozen sessions, always shown even if older than the scan window."""
        out = [r for r in rows if r["id"] in frozen]
        have = {r["id"] for r in out}
        for sid in frozen:
            if sid not in have:
                r = row_for(sid, live)
                if r: out.append(r)
        out.sort(key=lambda r: frozen.get(r["id"], {}).get("at", 0), reverse=True)
        return out

    if as_json:
        pinned = pinned_rows()
        body = [r for r in rows if r["id"] not in frozen]
        all_rows = pinned + body + closed_rows()
        if not all_rows:
            print("[]"); return
        for r in all_rows:
            r["ago"] = ago(r["mtime"]); r["frozen"] = r["id"] in frozen
            r["closed"] = r["id"] in closed
            r["started_local"] = when(r.get("started"))
        print(json.dumps(all_rows, indent=2)); return

    if not rows and not frozen:
        print("No sessions found."); return

    show_closed = False
    while True:
        pinned_ids = pinned_rows()
        body_rows = [r for r in rows if r["id"] not in frozen]
        cbody = closed_rows() if show_closed else []
        w_agent = agent_width(pinned_ids + body_rows + cbody)
        pinned = print_pinned(pinned_ids, ago, frozen, w_agent=w_agent)
        if grouped:
            body = print_grouped(body_rows, ago, start=len(pinned), w_agent=w_agent)
        else:
            body = []
            print()
            for i, r in enumerate(body_rows, len(pinned) + 1):
                body.append(r)
                dot = "\033[32m●\033[0m" if r["live"] else " "
                proj = (r["proj"] or "?")[:22]
                line = (r["doing"] or r["tldr"])[:64]
                print(f" {dot} \033[1m{i:>3}\033[0m  \033[36m{proj:<22}\033[0m {ago(r['mtime']):>4}  "
                      f"{meta(r, w_agent)}  {line}")
            print(f"\n  \033[32m●\033[0m = running   ({len(body)} shown)")
        ordered = pinned + body
        if show_closed:
            if cbody:
                print(f"\n\033[1;34m🌙 closed\033[0m \033[2m({len(cbody)})\033[0m")
                ordered += print_grouped(cbody, ago, start=len(ordered), w_agent=w_agent)
            else:
                print("\n\033[1;34m🌙 closed\033[0m \033[2m(none)\033[0m")
        save_json(LAST, [{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"]}
                         for i, r in enumerate(ordered, 1)])

        tag = f" \033[33m/{filt}\033[0m" if filt else ""
        try:
            pick = input(f"\nResume #{tag}  (m=+100 more, c=closed, s=search, Enter=quit): ").strip()
        except (EOFError, KeyboardInterrupt):
            print(); return
        if not pick:
            return
        if pick.lower() == "m":
            take(100); continue
        if pick.lower() == "c":
            show_closed = not show_closed; continue
        if pick.lower() == "s":
            try:
                q = input("search (empty=clear): ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                print(); return
            filt = q or None
            rows[:] = []          # rescan from the top under the new filter
            fiter = iter(files)
            take(limit)
            continue
        try:
            r = ordered[int(pick) - 1]
        except (ValueError, IndexError):
            print("invalid"); continue
        if not r["cwd"] or not os.path.isdir(r["cwd"]):
            print(f"cwd missing: {r['cwd']}"); continue
        os.chdir(r["cwd"])
        os.execvp("claude", ["claude", "--resume", r["id"], "--dangerously-skip-permissions"])

if __name__ == "__main__":
    sys.exit(main() or 0)
