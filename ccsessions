#!/usr/bin/env python3
"""ccsessions — list Claude Code sessions (project, what it's doing) and resume one.

Usage:
  ccsessions            # 100 most-recent sessions (set CCSESSIONS_LIMIT to change)
  ccsessions -n 200     # show a custom count
  ccsessions -a         # show all
  ccsessions foo bar    # filter: transcripts containing every word
  tbe search <words…> [--json] [-n N]  # ranked full-text search; never prompts; exit 1 = no match
  ccsessions -g         # group by project (cockpit view)
  ccsessions --json     # machine-readable dump (for birdsan orchestration)
  tbe freeze [N] [note] # pin a session for later (no N = current session)
  tbe thaw <#|id>       # unpin
  tbe closed [N] [note] # mark a session closed — moves it to the (c) section
  tbe reopen <#|id>     # un-close
  tbe resume <#|id> [-p "prompt"] [--stream] [--force]  # resume; -p = headless (agent-safe),
                        #   --stream announces the session id on stderr the
                        #   moment claude starts, so `tbe watch <id>` can follow;
                        #   interactive resume refuses a session already live (--force)
  tbe watch <#|id>      # follow a session's transcript live (headless runs too)

In a terminal, tbe opens an arrow-key picker: ↑↓/jk move (PgUp/PgDn, g/G), Enter
resumes, / searches, c toggles closed, m loads 100 more, f/x toggle freeze/close on
the row, q quits; the lower pane previews the session's last messages. --plain (or
CCSESSIONS_PLAIN=1) keeps the numbered prompt below.
Numbered prompt keys: number or short id = resume, /words = search (s prompts; empty
clears), m = next 100 sessions, c = toggle closed section. Piped or run by an agent
(stdin not a terminal), tbe prints once, without colour, and never prompts.
Search covers the whole transcript (conversation, tool I/O, subagents) plus id, folder,
branch, agent and notes; <system-reminder> text is ignored.
"""
import os, sys, json, glob, subprocess, time, re, fcntl, shutil, io
from collections import Counter
from datetime import datetime

PROJECTS = os.path.expanduser("~/.claude/projects")
SESSION_IDENTITY = os.path.expanduser("~/.envoak/session-identity")  # dawn writes <sid>.env
FROZEN = os.path.expanduser("~/.claude/ccsessions-frozen.json")  # {id: {note, at, proj}}
CLOSED = os.path.expanduser("~/.claude/ccsessions-closed.json")  # {id: {note, at, proj}}
LAST = os.path.expanduser("~/.claude/ccsessions-last.json")      # [{n,id,proj,cwd}] of last render
REGISTRY = os.path.expanduser("~/.claude/sessions")               # Claude Code's own <pid>.json per live process
LOCKS = os.path.expanduser("~/.claude/tbe-locks")                 # <sid>.lock, flock held by the resumed claude

def load_json(p, default):
    try:
        with open(p) as fh: return json.load(fh)
    except Exception:
        return default

def save_json(p, data):
    try:
        with open(p, "w") as fh: json.dump(data, fh)
    except Exception:
        pass

def first(d, *keys):
    for k in keys:
        if k in d and d[k]:
            return d[k]
    return None

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):  # blocks
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
        return " ".join(str(b.get("text","")) for b in content if isinstance(b, dict))
    return ""

def noisy(t):
    return (t.startswith("<") or
            t.startswith("Base directory for this skill") or
            t.startswith("Caveat:") or "<command-" in t[:40])

def agent_of(sid):
    """Agent label dawn pinned to this session, '' if the session never ran dawn.
    Only the per-session file — the shared current-identity.env would stamp the
    SAME label on every row, which is worse than blank."""
    try:
        with open(os.path.join(SESSION_IDENTITY, f"{sid}.env")) as fh:
            m = re.search(r'ENVOAK_AGENT_LABEL="?([^"\n]+)', fh.read())
            return m.group(1) if m else ""
    except Exception:
        return ""

def when(iso):
    """'2026-07-31T13:36:02.123Z' → local 'Jul31 13:36'."""
    if not iso:
        return ""
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%b%d %H:%M")
    except Exception:
        return ""

def scan(path):
    """Return (cwd, tldr, doing, started) — tldr is the gist, doing is the LATEST
    activity, started is the first timestamp in the transcript (session birth)."""
    cwd, summary, first_user, started = None, None, None, None
    try:
        with open(path, "r", errors="ignore") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                cwd = cwd or d.get("cwd")
                started = started or d.get("timestamp")
                if d.get("type") == "summary" and not summary:
                    summary = d.get("summary")
                if first_user is None and d.get("type") == "user":
                    msg = d.get("message") or {}
                    if msg.get("role") == "user":
                        t = text_of(msg.get("content")).strip()
                        if t and not noisy(t):
                            first_user = t
                if cwd and (summary or first_user) and started:
                    break
    except Exception:
        pass
    tldr = summary or first_user or "(no preview)"
    return cwd, redact(" ".join(tldr.split())), redact(last_doing(path)), started  # every printed field is masked

def last_paragraph(t):
    """Final paragraph of a message — the conclusion/next-step, which is what you
    need when deciding whether to resume. Skips trailing code fences."""
    paras = [p.strip() for p in re.split(r"\n\s*\n", t) if p.strip()]
    while paras and paras[-1].startswith("```"):
        paras.pop()
    return paras[-1] if paras else t

def last_doing(path, nbytes=65536):
    """Tail the file for the LAST PARAGRAPH of the most recent meaningful
    user/assistant message — the freshest 'where this left off'.
    ponytail: 64KB tail, not a full read; bump if last turns are huge."""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as fh:
            if sz > nbytes:
                fh.seek(-nbytes, os.SEEK_END); fh.readline()
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except Exception:
        return ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") in ("user", "assistant"):
            t = text_of((d.get("message") or {}).get("content")).strip()
            if t and not noisy(t):
                return " ".join(last_paragraph(t).split())[:200]
    return ""

REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
ANSI = re.compile(r"\033\[[0-9;]*m")

def texts_of(d):
    """(weight, text) for one transcript line: conversation 3, tool input/output 1.
    Injected <system-reminder> blocks (CLAUDE.md, memory) are stripped — they are in
    nearly every transcript, so a word in CLAUDE.md would otherwise match them all."""
    out = []
    if d.get("type") == "summary":
        out.append((3, d.get("summary") or ""))
    elif d.get("type") in ("user", "assistant"):
        c = (d.get("message") or {}).get("content")
        if isinstance(c, str):
            out.append((3, c))
        for b in c if isinstance(c, list) else []:
            if not isinstance(b, dict): continue
            if b.get("type") == "text":
                out.append((3, b.get("text") or ""))
            elif b.get("type") == "tool_use":
                out.append((1, json.dumps(b.get("input"), ensure_ascii=False)))
            elif b.get("type") == "tool_result":
                r = b.get("content")
                out.append((1, r if isinstance(r, str) else
                            " ".join(x.get("text") or "" for x in r or [] if isinstance(x, dict))))
    return [(w, REMINDER.sub(" ", t)) for w, t in out if t]

SECRET = re.compile(
    r"(?i)(?:sk-[a-z0-9_-]{16,}|sb_(?:secret|publishable)_[a-z0-9_-]{8,}|gh[pousr]_[a-z0-9]{20,}"
    r"|github_pat_[a-z0-9_]{20,}|xox[abprs]-[a-z0-9-]{10,}|AKIA[A-Z0-9]{16}|eyJ[a-z0-9_-]{10,}\.[a-z0-9_.-]{10,}"
    r"|evk1_[a-z0-9_-]{10,}|pea1_[a-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|\b[0-9a-f]{40,}\b)")
URLCRED = re.compile(r"(?i)\b([a-z][a-z0-9+.-]*://[^/\s:@]+:)[^@\s/]+@")   # scheme://user:PASS@host
ASSIGN = re.compile(r"(?i)((?:key|token|secret|password|passwd|pwd)[\"']?\s*[=:]\s*[\"']?)[^\s\"',;&]{6,}")

def redact(t):
    """Mask credential shapes before a snippet leaves the process: transcripts hold tool
    output, and `tbe search` feeds agents. ponytail: known shapes + KEY=value; extend the list."""
    return ASSIGN.sub(r"\1‹redacted›", URLCRED.sub(r"\1‹redacted›@", SECRET.sub("‹redacted›", t)))

def snippet(text, term, width=110):
    """~width chars of text centred on the first hit of term, whitespace collapsed, secrets masked."""
    t = redact(" ".join(text.split()))
    i = max(t.lower().find(term), 0)
    a = max(0, i - width // 3)
    return ("…" if a else "") + t[a:a + width] + ("…" if a + width < len(t) else "")

def search_session(paths, terms, meta=""):
    """Full-text match of one session (its transcript + subagent transcripts).
    Every term must appear, case-insensitively, in conversation/tool text or in
    meta (id, cwd, agent, branch, freeze/close notes). Returns (score, snippet) or
    None. Score: conversation hits ×3, tool hits ×1; snippet is the newest
    conversation hit, else the newest tool hit.
    ponytail: full read per query (~0.4s warm for 700MB); index if it gets slow."""
    terms = list(dict.fromkeys(terms))                # `foo foo` is one term
    tb = [t.encode() for t in terms]
    found, score, last = set(), 0, {}
    for p in paths:
        try:
            with open(p, "rb") as fh: blob = fh.read()
        except OSError:
            continue
        meta += " " + " ".join(set(re.findall(r'"gitBranch":\s*"([^"]*)"', blob.decode("utf-8", "ignore"))))
        if not any(t in blob.lower() for t in tb):
            continue
        # ponytail: whole file in memory (largest seen 15 MB) for the fast prefilter; lines
        # are iterated, not listed. Stream from disk if transcripts reach hundreds of MB.
        for raw in io.BytesIO(blob):
            if not any(t in raw.lower() for t in tb): continue
            try:
                d = json.loads(raw)
            except Exception:
                continue
            for w, text in texts_of(d):
                low = text.lower()
                hit = [t for t in terms if t in low]
                if not hit: continue
                w = 1 if p != paths[0] else w         # subagent transcripts rank as tool output
                found.update(hit); score += w * len(hit)
                last[w] = (text, hit[0])              # last line wins = newest; snippet built once
    found |= {t for t in terms if t in meta.lower()}
    snip = {w: snippet(*v) for w, v in last.items()}
    if len(found) < len(terms):
        return None
    return score, snip.get(3) or snip.get(1) or ""

def session_paths(f):
    """The session's transcript plus its subagents' (<projdir>/<sid>/subagents/*.jsonl)."""
    return [f] + sorted(glob.glob(os.path.join(f[:-6], "subagents", "*.jsonl")))

def _proc_cwd(pid):
    try:
        r = subprocess.check_output(["lsof","-a","-p",pid,"-d","cwd","-Fn"], text=True, stderr=subprocess.DEVNULL)
        return next((l[1:] for l in r.splitlines() if l.startswith("n")), None)
    except Exception:
        return None

def running_sessions():
    """Set of session ids that are ACTUALLY running — one per live `claude` process.
    `--resume <id>` in argv pins the id exactly; a fresh start (no --resume) writes the
    newest jsonl in its cwd's project dir, so K procs in a cwd claim the K newest unclaimed
    sessions there. Far truer than the old per-cwd flag, which lit up every session that
    ever ran in a live folder (closed, ancient, all green).
    ponytail: argv + newest-mtime heuristic; exact for --resume, newest-jsonl for fresh."""
    try:
        pids = subprocess.check_output(["pgrep", "-x", "claude"], text=True).split()
    except Exception:
        return set()
    live, fresh_cwds = set(), []
    for p in pids:
        try:
            args = subprocess.check_output(["ps","-o","args=","-p",p], text=True)
        except Exception:
            args = ""
        m = re.search(r"--resume\s+([0-9a-fA-F-]{36})", args)
        if m:
            live.add(m.group(1)); continue
        cwd = _proc_cwd(p)
        if cwd:
            fresh_cwds.append(cwd)
    # fresh starts: each takes the newest not-yet-claimed jsonl in its cwd's project dir.
    # A fresh `claude` is writing RIGHT NOW, so only recently-touched files qualify — this
    # stops a surplus proc (e.g. a child/zombie) from lighting up an ancient session.
    cutoff = time.time() - 2 * 3600
    for cwd, k in Counter(fresh_cwds).items():
        pdir = os.path.join(PROJECTS, cwd.replace("/", "-"))
        js = sorted(glob.glob(os.path.join(pdir, "*.jsonl")), key=os.path.getmtime, reverse=True)
        for f in js:
            if k <= 0: break
            if os.path.getmtime(f) < cutoff: break
            sid = os.path.basename(f)[:-6]
            if sid not in live:
                live.add(sid); k -= 1
    return live

def registry_pid(sid, registry=None):
    """pid of a live claude registered for sid in Claude Code's ~/.claude/sessions/<pid>.json, else None.
    Files of exited processes linger and pids get reused, so the pid must still have the file's
    procStart (UTC, C locale: `Sun Oct  4 18:37:39 2026`) as its start time. No procStart: counts."""
    for f in glob.glob(os.path.join(registry or REGISTRY, "*.json")):
        d = load_json(f, {})
        if not isinstance(d, dict) or d.get("sessionId") != sid or not isinstance(d.get("pid"), int): continue
        try:
            start = subprocess.check_output(["ps", "-o", "lstart=", "-p", str(d["pid"])], text=True,
                                            stderr=subprocess.DEVNULL, env={**os.environ, "LC_ALL": "C", "TZ": "UTC"}).split()
        except Exception:
            continue                      # not running
        if not d.get("procStart") or str(d["procStart"]).split() == start:
            return d["pid"]
    return None

def claim(sid, registry=None, locks=None):
    """One interactive writer per session. Refuses when claude is already live on sid, else takes an
    flock that exec carries into claude, so another `tbe resume` of sid refuses until claude exits
    (it also covers the seconds before claude registers itself). Returns the refusal, or None.
    Headless -p resumes skip this on purpose: cc-ghost-watch is built on them landing in live sessions.
    ponytail: claude's children inherit the fd; one outliving claude keeps the lock — --force then."""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", sid or ""):
        return f"not a session id: {sid!r}"   # the lock path is built from it; the listing cache is just a file
    pid = registry_pid(sid, registry)
    if pid:
        return f"session {sid[:8]} is already running (pid {pid}); not starting a second writer."
    d = locks or LOCKS
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(d, sid + ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return f"session {sid[:8]} is being resumed elsewhere (tbe lock held); not starting a second writer. --force overrides."
    os.set_inheritable(fd, True)
    return None

def find_file(sid):
    """Prefix match first (statusline short ids are id prefixes), substring as
    fallback; newest wins on collision — 3 hex chars can repeat across history."""
    g = (glob.glob(os.path.join(PROJECTS, "*", f"{sid}*.jsonl")) or
         glob.glob(os.path.join(PROJECTS, "*", f"*{sid}*.jsonl")))
    return max(g, key=os.path.getmtime) if g else None

def row_for(sid, live, f=None):
    """Build a row for a session id (may be older than the scan window)."""
    f = f or find_file(sid)
    if not f:
        return None
    cwd, tldr, doing, started = scan(f)
    proj = os.path.basename(cwd) if cwd else os.path.basename(os.path.dirname(f))
    sid = os.path.basename(f)[:-6]
    return {"id": sid, "cwd": cwd, "proj": proj, "tldr": tldr, "doing": doing, "file": f,
            "mtime": os.path.getmtime(f), "live": sid in live,
            "started": started, "agent": agent_of(sid)}

def _numeric_row(key, last_rows):
    """Row from the last listing matching key-as-a-listing-number, or None if
    key isn't all-digit or no row has that number. Pure (no I/O) so it's
    testable without filesystem fixtures — real callers pass load_json(LAST,
    []); tests pass a literal list."""
    if not key.isdigit():
        return None
    return next((r for r in last_rows if r["n"] == int(key)), None)

def _resolve_sid(rest, verb):
    """(sid, proj, remaining-args). Leading token resolves against the last
    listing by number first (statusline short ids are 3 hex chars, some of
    which are all-digit — a pure listing number must still win over a
    same-looking id prefix); if no row has that number, fall back to
    id-prefix resolution via find_file. No token = the CURRENT session
    ($CLAUDE_CODE_SESSION_ID)."""
    if rest:
        row = _numeric_row(rest[0], load_json(LAST, []))
        if row:
            return row["id"], row.get("proj"), rest[1:]
        if rest[0].isdigit():
            f = find_file(rest[0])
            r = row_for(os.path.basename(f)[:-6], set()) if f else None
            if r:
                return r["id"], r["proj"], rest[1:]
            print(f"no #{rest[0]} in the last listing and no session matching {rest[0]} — run `tbe` first, then {verb}.")
            return None, None, rest[1:]
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print(f"not inside a session — use: tbe {verb} <#> [note]")
    return sid, None, rest

def _mark(path, rest, verb, emoji):
    """Shared body of freeze/closed: stamp {note, at, proj} for a session."""
    sid, proj, rest = _resolve_sid(rest, verb)
    if not sid:
        return
    marks = load_json(path, {})
    marks[sid] = {"note": " ".join(rest), "at": time.time(), "proj": proj}
    save_json(path, marks)
    print(f"{emoji} {verb} {sid[:8]} — {marks[sid]['note'] or '(no note)'}")

def _unmark(path, rest, verb, emoji, done, noun):
    marks = load_json(path, {})
    if not rest:
        print(f"usage: tbe {verb} <#|id>"); return
    key = rest[0]
    row = _numeric_row(key, load_json(LAST, []))
    # Pure listing number wins if present; otherwise (including a digit-only
    # short id with no matching row) fall back to prefix match against marks.
    sid = row["id"] if row else next((k for k in marks if k.startswith(key)), key)
    if sid in marks:
        del marks[sid]; save_json(path, marks); print(f"{emoji} {done} {sid[:8]}")
    else:
        print(f"not {noun}: {key}")

def _resolve_session(key):
    """(sid, cwd) for a listing number or id prefix, (None, None) + message if
    unresolvable. Pure listing number wins if present; otherwise (including a
    digit-only short id with no matching row, e.g. `819`) id-prefix match."""
    row = _numeric_row(key, load_json(LAST, []))
    if row:
        return row["id"], row.get("cwd")
    f = find_file(key)
    if not f:
        msg = (f"no #{key} in the last listing and no session matching {key}."
                if key.isdigit() else f"no session matching: {key}")
        print(msg); return None, None
    return os.path.basename(f)[:-6], scan(f)[0]

def cmd_resume(rest):
    """tbe resume <#|id> [-p "prompt"] [--stream] — resume a session by number
    (from the last listing) or id prefix. With -p, runs `claude -p --resume`
    headless — no TTY needed, so agents can call this from a Bash tool. With
    --stream (implies headless), the session id is announced on stderr
    the moment claude starts, so `tbe watch <shortid>` can follow it live;
    stdout still carries only the final result text. Without -p, execs the
    interactive TUI exactly like the picker."""
    # --force only before -p: everything after -p is the prompt, passed through untouched.
    pre = rest[:rest.index("-p")] if "-p" in rest else rest
    force = "--force" in pre
    if force:
        rest.remove("--force")
    prompt, stream = None, False
    if "--stream" in rest:
        stream = True; rest = [a for a in rest if a != "--stream"]
    if "-p" in rest:
        i = rest.index("-p")
        prompt = " ".join(rest[i + 1:])
        rest = rest[:i]
        if not prompt:
            print("empty -p prompt"); return 2
    if not rest:
        print('usage: tbe resume <#|id> [-p "prompt"] [--stream]'); return 2
    if stream and not prompt:
        print("--stream needs -p (headless only)"); return 2
    sid, cwd = _resolve_session(rest[0])
    if not sid:
        return 2
    if not cwd or not os.path.isdir(cwd):
        print(f"cwd missing: {cwd}"); return 2
    os.chdir(cwd)
    if prompt and stream:
        # stream-json: init event carries the session id, result event the
        # final text. Pinned live 2026-08-05: headless --resume does NOT fork —
        # it APPENDS to the original session's transcript (same id in init,
        # same jsonl grows). Resuming a LIVE session therefore writes into a
        # transcript another process is also writing.
        p = subprocess.Popen(
            ["claude", "-p", "--resume", sid, "--output-format", "stream-json",
             "--verbose", "--dangerously-skip-permissions", prompt],
            stdout=subprocess.PIPE, text=True)
        final = ""
        for line in p.stdout:
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("type") == "system" and d.get("subtype") == "init":
                run_sid = d.get("session_id", "")
                print(f"⏵ session {run_sid[:8]} running — follow with: tbe watch {run_sid[:8]}",
                      file=sys.stderr, flush=True)
            elif d.get("type") == "result":
                final = d.get("result") or ""
        p.wait()
        print(final)
        return p.returncode
    if prompt:
        return subprocess.call(["claude", "-p", "--resume", sid,
                                "--dangerously-skip-permissions", prompt])
    why = None if force else claim(sid)
    if why:
        print(why, file=sys.stderr); return 3
    os.execvp("claude", ["claude", "--resume", sid, "--dangerously-skip-permissions"])

def cmd_watch(rest):
    """tbe watch <#|id> — follow a session's transcript live (tail -f style).
    Prints each new user/assistant text and tool call as it lands in the jsonl.
    Works on headless runs the moment `resume --stream` announces their id.
    Ctrl-C to stop."""
    if not rest:
        print("usage: tbe watch <#|id>"); return 2
    sid, _ = _resolve_session(rest[0])
    if not sid:
        return 2
    f = find_file(sid)
    print(f"👁 watching {sid[:8]} ({os.path.basename(os.path.dirname(f))}) — Ctrl-C to stop")
    def render(d):
        t = d.get("type")
        if t not in ("user", "assistant"):
            return
        msg = d.get("message") or {}
        content = msg.get("content")
        if isinstance(content, list):
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "tool_use":
                    print(f"  \033[2m⚙ {b.get('name')}\033[0m")
                elif b.get("type") == "text" and b.get("text", "").strip():
                    tag = "\033[36mA\033[0m" if t == "assistant" else "\033[33mU\033[0m"
                    print(f"{tag} {' '.join(b['text'].split())[:300]}")
        elif isinstance(content, str) and content.strip() and not noisy(content.strip()):
            tag = "\033[36mA\033[0m" if t == "assistant" else "\033[33mU\033[0m"
            print(f"{tag} {' '.join(content.split())[:300]}")
    try:
        with open(f, errors="ignore") as fh:
            for line in fh:          # backlog first, then follow
                try: render(json.loads(line))
                except Exception: pass
            while True:
                line = fh.readline()
                if not line:
                    time.sleep(0.5); continue
                try: render(json.loads(line))
                except Exception: pass
    except KeyboardInterrupt:
        print(); return 0

def cmd_freeze(rest): _mark(FROZEN, rest, "freeze", "📌")
def cmd_thaw(rest):   _unmark(FROZEN, rest, "thaw", "🫧", "thawed", "frozen")
def cmd_closed(rest): _mark(CLOSED, rest, "closed", "🌙")
def cmd_reopen(rest): _unmark(CLOSED, rest, "reopen", "🌤", "reopened", "closed")

class _Plain:
    """stdout without ANSI colour, for pipes and agents."""
    def __init__(self, f): self.f = f
    def write(self, t): return self.f.write(ANSI.sub("", t))
    def __getattr__(self, k): return getattr(self.f, k)

def fit(prefix, text):
    """prefix + text cut to the terminal width (80 cols when not a terminal… but
    then 200, since a pipe has no edge to wrap at)."""
    cols = shutil.get_terminal_size((200, 24)).columns if sys.stdout.isatty() else 200
    room = max(cols - len(ANSI.sub("", prefix)) - 1, 20)
    return prefix + (text if len(text) <= room else text[:room - 1] + "…")

def line_of(r):
    """What a row shows: the search hit when there is one, else where it left off."""
    return r.get("hit") or r["doing"] or r["tldr"]

def meta(r, w_agent):
    """short-id + agent + session-start columns. The short id (first 3 chars of
    the session id) matches the statusline's #a28 and feeds `tbe resume a28`.
    w_agent=0 drops the agent column entirely (nothing in this listing ran
    dawn), so we don't pay 10 blank chars a row."""
    a = f"\033[36m{(r.get('agent') or '')[:w_agent]:<{w_agent}}\033[0m " if w_agent else ""
    return f"\033[2m{r['id'][:3]}\033[0m {a}\033[2m{when(r.get('started')):<11}\033[0m"

def agent_width(rows, cap=12):  # fits the longest real label, e.g. "spidersan-m5"
    w = max((len(r.get("agent") or "") for r in rows), default=0)
    return min(w, cap)

def print_pinned(rows, ago, frozen, start=0, w_agent=0):
    """Render the 📌 frozen section at the very top. Returns rows in print order."""
    if not rows:
        return []
    print(f"\n\033[1;35m📌 frozen\033[0m \033[2m({len(rows)})\033[0m")
    out, i = [], start
    for r in rows:
        i += 1; out.append(r)
        dot = "\033[32m●\033[0m" if r["live"] else " "
        note = r.get("hit") or frozen.get(r["id"], {}).get("note") or line_of(r)
        print(fit(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  \033[35m{r['proj'][:14]:<14}\033[0m "
                  f"{meta(r, w_agent)}  ", note))
    print()
    return out

def group_rows(rows):
    """[(project, rows newest first)], freshest project first — the cockpit order."""
    groups = {}
    for r in rows:
        groups.setdefault(r["proj"] or "?", []).append(r)
    order = sorted(groups, key=lambda p: max(x["mtime"] for x in groups[p]), reverse=True)
    return [(p, sorted(groups[p], key=lambda x: x["mtime"], reverse=True)) for p in order]

def print_grouped(rows, ago, start=0, w_agent=0):
    """Cockpit view: sessions bucketed by project, freshest project first.
    Returns rows in printed order so resume-by-number still lines up."""
    gs = group_rows(rows)
    order = [p for p, _ in gs]
    out, i = [], start
    print()
    for proj, g in gs:
        n_live = sum(1 for x in g if x["live"])
        flag = f" \033[32m{n_live} live\033[0m" if n_live else ""
        print(f"\033[1;36m{proj}\033[0m  \033[2m({len(g)}){flag}\033[0m")
        for r in g:
            i += 1; out.append(r)
            dot = "\033[32m●\033[0m" if r["live"] else " "
            print(fit(f"  {dot} \033[1m{i:>3}\033[0m {ago(r['mtime']):>4}  {meta(r, w_agent)}  ", line_of(r)))
        print()
    print(f"  \033[32m●\033[0m = running   ({len(out)} sessions, {len(order)} projects)")
    return out

def print_ranked(cands, top, as_json, ago, frozen, closed):
    """`tbe search`: best matches first, never prompts. --json carries no tldr/doing: agents get
    session facts plus the one masked hit, not free transcript text (masking is best effort). Score is capped so that among
    strong matches the newest wins. Exit 1 when nothing matched (agent-friendly)."""
    seen, rows = set(), []
    for r in sorted(cands, key=lambda r: (min(r.get("score", 0), 30), r["mtime"]), reverse=True):
        if r["id"] not in seen:
            seen.add(r["id"]); rows.append(r)
    rows = rows[:top]
    save_json(LAST, [{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"]} for i, r in enumerate(rows, 1)])
    if as_json:
        print(json.dumps([{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"], "agent": r["agent"],
                           "live": r["live"], "frozen": r["id"] in frozen, "closed": r["id"] in closed,
                           "ago": ago(r["mtime"]), "started_local": when(r.get("started")),
                           "score": r.get("score", 0), "hit": r.get("hit", ""), "file": r["file"]}
                          for i, r in enumerate(rows, 1)], indent=2, ensure_ascii=False))
        return 0 if rows else 1
    if not rows:
        print("no session matches"); return 1
    w_agent = agent_width(rows)
    print()
    for i, r in enumerate(rows, 1):
        dot = "\033[32m●\033[0m" if r["live"] else ("📌" if r["id"] in frozen else ("🌙" if r["id"] in closed else " "))
        print(fit(f" {dot} \033[1m{i:>3}\033[0m  \033[36m{(r['proj'] or '?')[:18]:<18}\033[0m {ago(r['mtime']):>4}  "
                  f"{meta(r, w_agent)}  ", r.get("hit") or line_of(r)))
    print(f"\n  {len(rows)} best of {len(seen)} matching — `tbe resume <#>` to open, -n for more")
    return 0

def recent(path, n=6, nbytes=262144):
    """Last n meaningful (role, text) messages, secrets masked — the picker's preview."""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as fh:
            if sz > nbytes:
                fh.seek(-nbytes, os.SEEK_END); fh.readline()
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return []
    out = []
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") in ("user", "assistant"):
            t = REMINDER.sub(" ", text_of((d.get("message") or {}).get("content"))).strip()
            if t and not noisy(t):
                out.append((d["type"], redact(" ".join(t.split()))))
                if len(out) == n: break
    return out[::-1]

def picker_items(pinned, body, cbody, grouped):
    """Flat picker list: ("h", header) rows are skipped by the cursor, ("r", row) are sessions."""
    items = []
    if pinned:
        items += [("h", f"frozen ({len(pinned)})")] + [("r", r) for r in pinned]
    if grouped:
        for proj, g in group_rows(body):
            live = sum(1 for r in g if r["live"])
            items += [("h", f"{proj} ({len(g)}{f', {live} live' if live else ''})")] + [("r", r) for r in g]
    elif body:
        items += [("h", f"recent ({len(body)})")] + [("r", r) for r in body]
    if cbody:
        items += [("h", f"closed ({len(cbody)})")] + [("r", r) for r in cbody]
    return items

def wrap(text, width, lines):
    """text cut into at most `lines` lines of `width` chars."""
    out = [text[i:i + width] for i in range(0, len(text), width)][:lines]
    if len(text) > width * lines and out: out[-1] = out[-1][:-1] + "…"
    return out

def run_picker(items, ago, frozen, closed, filt, show_closed, at_id=None):
    """Arrow-key picker (stdlib curses). Returns (action, payload): ("resume", row),
    ("search", words), ("closed", None), ("more", None), ("mark", (path, row)), ("quit", None)."""
    import curses
    sel = [i for i, (k, _) in enumerate(items) if k == "r"]
    cache = {}

    def draw(scr, cur, top):
        scr.erase()
        h, w = scr.getmaxyx()
        prev_h = max(min(14, h // 2), 6)
        list_h = h - prev_h - 2
        title = f" tbe  {len(sel)} sessions" + (f"   /{filt}" if filt else "") + ("   +closed" if show_closed else "")
        scr.addnstr(0, 0, title.ljust(w), w - 1, curses.A_REVERSE)
        for y, (k, v) in enumerate(items[top:top + list_h], 1):
            i = top + y - 1
            if k == "h":
                scr.addnstr(y, 0, v, w - 1, curses.color_pair(2) | curses.A_BOLD); continue
            mark = "●" if v["live"] else ("*" if v["id"] in frozen else " ")
            line = f" {mark} {ago(v['mtime']):>4}  {v['id'][:3]}  {(v.get('agent') or '')[:12]:<12} {line_of(v)}"
            attr = curses.A_REVERSE if i == cur else (curses.color_pair(1) if v["live"] else 0)
            scr.addnstr(y, 0, line.ljust(w), w - 1, attr)
        if not sel:
            scr.addnstr(2, 1, "no session matches — / to search again, empty search clears", w - 2, curses.A_DIM)
        r = items[cur][1] if sel else None
        y0 = list_h + 1
        scr.addnstr(y0, 0, "─" * w, w - 1, curses.A_DIM)
        if r:
            state = ", ".join(x for x, on in (("live", r["live"]), ("frozen", r["id"] in frozen),
                                              ("closed", r["id"] in closed)) if on)
            head = f" {r['proj']}  ·  {r['id'][:8]}  ·  {r.get('agent') or 'no agent'}  ·  started {when(r.get('started'))}" \
                   + (f"  ·  {state}" if state else "")
            scr.addnstr(y0 + 1, 0, head, w - 1, curses.A_BOLD)
            scr.addnstr(y0 + 2, 0, f" {r['cwd'] or '?'}", w - 1, curses.A_DIM)
            body = ([("match", r["hit"])] if r.get("hit") else []) + \
                   cache.setdefault(r["id"], recent(r["file"]) if r.get("file") else [])
            y = y0 + 3
            lines = []
            for who, t in body:
                tag = {"user": "you ", "assistant": "cc  ", "match": "hit "}[who]
                for j, l in enumerate(wrap(t, w - 6, 2)):
                    lines.append(((tag if j == 0 else "    ") + " " + l, who))
            for l, who in lines[-(h - 1 - y):] if h - 1 - y > 0 else []:
                scr.addnstr(y, 1, l, w - 2, curses.color_pair(3) if who == "user" else
                            (curses.color_pair(2) if who == "match" else 0))
                y += 1
        keys = " ↑↓ move  ⏎ resume  / search  c closed  m more  f freeze  x close  q quit "
        scr.addnstr(h - 1, 0, keys.ljust(w), w - 1, curses.A_REVERSE)
        scr.refresh()

    def prompt(scr, label):
        h, w = scr.getmaxyx()
        scr.addnstr(h - 1, 0, label.ljust(w), w - 1, curses.A_REVERSE)
        curses.echo(); curses.curs_set(1)
        try:
            return scr.getstr(h - 1, len(label), 200).decode("utf-8", "ignore")
        except Exception:
            return None
        finally:
            curses.noecho(); curses.curs_set(0)

    def loop(scr):
        curses.curs_set(0); curses.use_default_colors()
        for n, c in ((1, curses.COLOR_GREEN), (2, curses.COLOR_CYAN), (3, curses.COLOR_YELLOW)):
            curses.init_pair(n, c, -1)
        pos = next((j for j, i in enumerate(sel) if items[i][1]["id"] == at_id), 0)
        top = 0
        while True:
            h = scr.getmaxyx()[0]
            list_h = max(h - max(min(14, h // 2), 6) - 2, 1)
            cur = sel[pos] if sel else 0
            if cur < top + 1: top = max(cur - 1, 0)       # keep the section header in view
            if cur >= top + list_h: top = cur - list_h + 1
            draw(scr, cur, top)
            k = scr.getch()
            if k in (curses.KEY_DOWN, ord("j")): pos = min(pos + 1, len(sel) - 1)
            elif k in (curses.KEY_UP, ord("k")): pos = max(pos - 1, 0)
            elif k == curses.KEY_NPAGE: pos = min(pos + list_h, len(sel) - 1)
            elif k == curses.KEY_PPAGE: pos = max(pos - list_h, 0)
            elif k in (curses.KEY_HOME, ord("g")): pos = 0
            elif k in (curses.KEY_END, ord("G")): pos = len(sel) - 1
            elif k in (10, 13, curses.KEY_ENTER) and sel: return "resume", items[cur][1]
            elif k == ord("/"):
                q = prompt(scr, " search words (empty = clear): ")
                if q is not None: return "search", q
            elif k == ord("c"): return "closed", None
            elif k == ord("m"): return "more", None
            elif k in (ord("f"), ord("x")) and sel:
                return "mark", (FROZEN if k == ord("f") else CLOSED, items[cur][1])
            elif k in (ord("q"), 27): return "quit", None
            elif k == curses.KEY_RESIZE: pass
    try:
        return curses.wrapper(loop)
    except KeyboardInterrupt:
        return "quit", None

def _selftest():
    # the two load-bearing bits of running_sessions(): --resume id capture + cwd→projdir encoding
    rid = "246effba-e0d4-4fa1-be5e-7411e403eadb"
    m = re.search(r"--resume\s+([0-9a-fA-F-]{36})", f"claude --resume {rid} --dangerously-skip-permissions")
    assert m and m.group(1) == rid, "resume regex"
    assert "/Users/freedbird/Dev/Envoak".replace("/", "-") == "-Users-freedbird-Dev-Envoak", "projdir encoding"
    # UTC transcript stamps must land in local time, and a missing one must not blow up
    os.environ["TZ"] = "UTC"; time.tzset()
    assert when("2026-07-31T13:36:02.123Z") == "Jul31 13:36", "timestamp format"
    assert when(None) == "" and when("garbage") == "", "timestamp fallbacks"
    assert agent_of("no-such-session-id") == "", "agent fallback"
    assert agent_width([{"agent": "sherlock-m5"}, {"agent": ""}]) == 11, "agent column width"
    assert agent_width([{"agent": ""}]) == 0, "agent column hidden when unused"
    # last_paragraph: conclusion wins, trailing code fence skipped, plain text intact
    msg = "Idea good, half exists.\n\nMiddle detail.\n\nWant me build it? Piece 2+3 in repo."
    assert last_paragraph(msg) == "Want me build it? Piece 2+3 in repo.", "last paragraph"
    assert last_paragraph("Fix:\n\n```py\nx=1\n```") == "Fix:", "code fence skipped"
    assert last_paragraph("one liner") == "one liner", "single paragraph"
    # numeric-key resolution: pure listing number wins; digit-only short id
    # (e.g. "819") that ISN'T a listing number must not raise/mismatch here —
    # callers fall back to find_file/prefix match when this returns None.
    rows = [{"n": 3, "id": "abcd1234"}, {"n": 819, "id": "collide-row"}]
    assert _numeric_row("3", rows)["id"] == "abcd1234", "pure listing number wins"
    assert _numeric_row("819", rows)["id"] == "collide-row", "listing number that happens to look like a short id still wins"
    assert _numeric_row("819", rows[:1]) is None, "digit-only short id with no matching row falls through"
    assert _numeric_row("a28", rows) is None, "non-digit key never treated as a listing number"
    # claim(): a live registered claude refuses; a stale file (dead pid) doesn't; a second claim refuses
    import tempfile, uuid
    with tempfile.TemporaryDirectory() as reg, tempfile.TemporaryDirectory() as locks:
        sid, me = str(uuid.uuid4()), os.getpid()
        mine = subprocess.check_output(["ps", "-o", "lstart=", "-p", str(me)], text=True,
                                       env={**os.environ, "LC_ALL": "C", "TZ": "UTC"}).strip()
        save_json(os.path.join(reg, "1.json"), {"pid": me, "sessionId": sid, "procStart": mine})
        assert registry_pid(sid, reg) == me, "live registered pid found"
        assert "already running" in (claim(sid, reg, locks) or ""), "live session refused"
        save_json(os.path.join(reg, "1.json"), {"pid": me, "sessionId": sid, "procStart": "Thu Jan  1 00:00:00 1970"})
        assert registry_pid(sid, reg) is None, "reused pid (start time differs) is not the session"
        save_json(os.path.join(reg, "1.json"), {"pid": 999999, "sessionId": sid})
        assert registry_pid(sid, reg) is None, "dead pid ignored"
        assert claim(sid, reg, locks) is None, "first claim takes the lock"
        assert "lock held" in (claim(sid, reg, locks) or ""), "second claim refused while the first holds it"
        assert "not a session id" in (claim("/tmp/tbe-target", reg, locks) or ""), "path-shaped id refused"
        assert not os.path.exists("/tmp/tbe-target.lock"), "no lock file outside LOCKS"
    # search: AND over terms, reminders don't count, meta counts, subagent hits rank as tool, snippet is text
    with tempfile.TemporaryDirectory() as d:
        main_f, sub_f = os.path.join(d, "s.jsonl"), os.path.join(d, "s", "subagents", "a.jsonl")
        os.makedirs(os.path.dirname(sub_f))
        line = lambda typ, c: json.dumps({"type": typ, "message": {"role": typ, "content": c}, "gitBranch": "artisan/x"})
        with open(main_f, "w") as fh:
            fh.write("\n".join([
                line("user", "<system-reminder>prsan everywhere</system-reminder> fix the \"flock\" bug"),
                line("assistant", [{"type": "tool_use", "input": {"command": "grep flock"}}]),
                line("assistant", [{"type": "text", "text": "Done: flock now held across exec."}])]))
        with open(sub_f, "w") as fh:
            fh.write(line("assistant", [{"type": "text", "text": "subagent saw walrus"}]))
        paths = session_paths(main_f)
        assert paths == [main_f, sub_f], "subagent transcripts belong to the session"
        score, snip = search_session(paths, ["flock"])
        assert score == 3 + 1 + 3 and snip.startswith("Done: flock"), "weights + newest conversation snippet"
        assert '\\"' not in search_session(paths, ["bug"])[1], "snippet is decoded text, not raw json"
        assert search_session(paths, ["prsan"]) is None, "a word only in a system-reminder doesn't match"
        assert search_session(paths, ["flock", "nowhere"]) is None, "all terms must match"
        assert search_session(paths, ["flock", "artisan/x"]), "branch is searchable"
        assert search_session(paths, ["flock", "mynote"], "id mynote") , "meta (id/notes) counts"
        assert search_session(paths, ["walrus"])[0] == 1, "subagent hit ranks as tool output"
        assert search_session(paths, ["flock", "flock"]), "duplicate words are one term"
        assert search_session(paths, ["onlyinmeta"], "id onlyinmeta"), "a word only in meta still matches"
    for leak in ["OPENAI_API_KEY=sk-test0123456789abcdefXYZ", "token: ghp_" + "a" * 36, "sb_secret_" + "b" * 30,
                 "password=hunter2hunter", "DATABASE_URL=postgres://app:s3cr3tpw@db.host/x", "-----BEGIN OPENSSH PRIVATE KEY-----", "key " + "c" * 64]:
        out = snippet("ran it: " + leak + " done", "ran")
        secret = "s3cr3tpw" if "postgres" in leak else leak[-6:]
        assert "‹redacted›" in out and secret not in out, f"secret masked: {leak[:12]}"
    assert snippet("fix the flock bug", "flock") == "fix the flock bug", "plain text untouched"
    with tempfile.TemporaryDirectory() as d:     # tldr/doing reach --json too, so scan() masks them
        f = os.path.join(d, "s.jsonl")
        with open(f, "w") as fh:
            fh.write(json.dumps({"type": "user", "cwd": d, "timestamp": "t", "message": {"role": "user",
                     "content": "use OPENAI_API_KEY=sk-test0123456789abcdefXYZ"}}))
        _, tldr, doing, _ = scan(f)
        assert "abcdefXYZ" not in tldr + doing and "‹redacted›" in tldr, "preview fields masked"
    # picker list: frozen first, projects freshest-first with live counts, closed last; headers aren't rows
    R = lambda i, proj, m, live=False: {"id": i, "proj": proj, "mtime": m, "live": live}
    items = picker_items([R("f", "A", 1)], [R("a1", "A", 5), R("b1", "B", 9, True), R("a2", "A", 7)],
                         [R("c", "C", 3)], grouped=True)
    assert [v if k == "h" else v["id"] for k, v in items] == \
        ["frozen (1)", "f", "B (1, 1 live)", "b1", "A (2)", "a2", "a1", "closed (1)", "c"], "picker order"
    assert picker_items([], [], [], grouped=False) == [], "empty listing has no headers"
    assert wrap("abcdefgh", 3, 2) == ["abc", "de…"], "preview wrap ellipsis"
    print("selftest ok"); return

def main():
    args = sys.argv[1:]
    if args and args[0] == "--selftest": return _selftest()
    if args and args[0] == "freeze": return cmd_freeze(args[1:])
    if args and args[0] == "thaw":   return cmd_thaw(args[1:])
    if args and args[0] == "closed": return cmd_closed(args[1:])
    if args and args[0] == "reopen": return cmd_reopen(args[1:])
    if args and args[0] == "resume": return cmd_resume(args[1:])
    if args and args[0] == "watch":  return cmd_watch(args[1:])
    if args and args[0] in ("-h", "--help", "help"): print(__doc__.strip()); return
    ranked = bool(args) and args[0] in ("search", "find")
    if ranked: args = args[1:]
    limit, filt = int(os.environ.get("CCSESSIONS_LIMIT", "100")), None
    as_json = "--json" in args; args = [a for a in args if a != "--json"]
    # Invoked as `tbe` (TreeBirdsEye) → grouped cockpit by default.
    grouped = "-g" in args or os.path.basename(sys.argv[0]).startswith("tbe")
    args = [a for a in args if a not in ("-g", "--plain")]   # --plain: numbered prompt, no picker
    if as_json: limit = 10**9
    if "-a" in args: limit = 10**9; args.remove("-a")
    top = 20
    if "-n" in args:
        i = args.index("-n"); limit = top = int(args[i+1]); del args[i:i+2]
    if ranked: limit = 10**9            # rank every session, then cut to -n (default 20)
    filt = " ".join(args).lower() or None   # all words must match (AND)
    if ranked and not filt:
        print("usage: tbe search <words…> [--json] [-n N]"); return 2
    if not sys.stdout.isatty() and not as_json:
        sys.stdout = _Plain(sys.stdout)     # piped / agent: no colour codes

    files = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)

    frozen = load_json(FROZEN, {})
    closed = load_json(CLOSED, {})
    live = running_sessions()

    me = os.environ.get("CLAUDE_CODE_SESSION_ID")   # an agent searching shouldn't find itself

    def hit(sid, f):
        """None = no match. No query matches everything ({}); otherwise the full-text
        score + snippet. Runs BEFORE the row is built, so misses cost one file read."""
        if not filt:
            return {}
        if sid == me:
            return None
        notes = " ".join((m.get(sid) or {}).get("note") or "" for m in (frozen, closed))
        # the project dir name is the cwd with / → -, close enough to match a path word
        res = search_session(session_paths(f), filt.split(),
                             " ".join([sid, os.path.basename(os.path.dirname(f)), agent_of(sid), notes]))
        return {"score": res[0], "hit": res[1]} if res else None

    by_id = {os.path.basename(f)[:-6]: f for f in files}

    def marked_row(sid):
        """Row for a frozen/closed session by id, or None if gone or not a match.
        Matched first, from the listing's own file map: a glob per id took seconds."""
        f = by_id.get(sid)
        h = hit(sid, f) if f else None
        return {**row_for(sid, live, f), **h} if h is not None else None
    rows, fiter = [], iter(files)

    def take(k):
        """Scan the next k matching sessions into rows. Closed sessions are
        skipped here — they live in the (c) section (frozen outranks closed)."""
        for f in fiter:
            if k <= 0:
                return
            sid = os.path.basename(f)[:-6]
            if sid in closed and sid not in frozen:
                continue
            h = hit(sid, f)
            if h is None:
                continue
            rows.append({**row_for(sid, live, f), **h})
            k -= 1

    take(limit)

    now = time.time()
    def ago(t):
        s = now - t
        if s < 3600: return f"{int(s//60)}m"
        if s < 86400: return f"{int(s//3600)}h"
        return f"{int(s//86400)}d"

    def closed_rows():
        """Rows for every closed session, newest first. The close note (why it
        ended) wins over the transcript tail when present."""
        out = []
        for sid, mark in closed.items():
            if sid in frozen:
                continue
            r = marked_row(sid)
            if r:
                if mark.get("note"):
                    r["doing"] = mark["note"]
                out.append(r)
        out.sort(key=lambda r: r["mtime"], reverse=True)
        return out

    def pinned_rows():
        """Frozen sessions, always shown even if older than the scan window."""
        out = [r for r in rows if r["id"] in frozen]
        have = {r["id"] for r in out}
        for sid in frozen:
            if sid not in have:
                r = marked_row(sid)
                if r: out.append(r)
        out.sort(key=lambda r: frozen.get(r["id"], {}).get("at", 0), reverse=True)
        return out

    if ranked:
        return print_ranked(rows + closed_rows(), top, as_json, ago, frozen, closed)

    if as_json:
        pinned = pinned_rows()
        body = [r for r in rows if r["id"] not in frozen]
        all_rows = pinned + body + closed_rows()
        if not all_rows:
            print("[]"); return
        for r in all_rows:
            r["ago"] = ago(r["mtime"]); r["frozen"] = r["id"] in frozen
            r["closed"] = r["id"] in closed
            r["started_local"] = when(r.get("started"))
        print(json.dumps(all_rows, indent=2)); return

    if not rows and not frozen:
        print("No sessions found."); return

    show_closed = False
    use_picker = (sys.stdin.isatty() and sys.stdout.isatty() and "--plain" not in sys.argv[1:]
                  and not os.environ.get("CCSESSIONS_PLAIN") and os.environ.get("TERM") != "dumb")
    at_id = None
    while True:
        pinned_ids = pinned_rows()
        body_rows = [r for r in rows if r["id"] not in frozen]
        cbody = closed_rows() if show_closed else []
        if use_picker:
            items = picker_items(pinned_ids, body_rows, cbody, grouped)
            save_json(LAST, [{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"]}
                             for i, r in enumerate((v for k, v in items if k == "r"), 1)])
            act, arg = run_picker(items, ago, frozen, closed, filt, show_closed, at_id)
            if act == "quit":
                return
            if act == "more":
                take(100); continue
            if act == "closed":
                show_closed = not show_closed; continue
            if act == "search":
                filt = arg.strip().lower() or None
                rows[:] = []; fiter = iter(files); take(limit); at_id = None
                continue
            if act == "mark":                 # f / x toggle freeze / close on the row
                path, r = arg
                marks = load_json(path, {})
                if marks.pop(r["id"], None) is None:
                    marks[r["id"]] = {"note": "", "at": time.time(), "proj": r["proj"]}
                save_json(path, marks)
                (frozen if path == FROZEN else closed).clear()
                (frozen if path == FROZEN else closed).update(marks)
                at_id = r["id"]
                if path == CLOSED:            # take() skips closed sessions: rescan
                    rows[:] = []; fiter = iter(files); take(limit)
                continue
            r = arg                           # resume
            if not r["cwd"] or not os.path.isdir(r["cwd"]):
                print(f"cwd missing: {r['cwd']}"); return 1
            why = claim(r["id"])
            if why:
                print(why); return 3
            os.chdir(r["cwd"])
            os.execvp("claude", ["claude", "--resume", r["id"], "--dangerously-skip-permissions"])
        w_agent = agent_width(pinned_ids + body_rows + cbody)
        pinned = print_pinned(pinned_ids, ago, frozen, w_agent=w_agent)
        if grouped:
            body = print_grouped(body_rows, ago, start=len(pinned), w_agent=w_agent)
        else:
            body = []
            print()
            for i, r in enumerate(body_rows, len(pinned) + 1):
                body.append(r)
                dot = "\033[32m●\033[0m" if r["live"] else " "
                proj = (r["proj"] or "?")[:22]
                print(fit(f" {dot} \033[1m{i:>3}\033[0m  \033[36m{proj:<22}\033[0m {ago(r['mtime']):>4}  "
                          f"{meta(r, w_agent)}  ", line_of(r)))
            print(f"\n  \033[32m●\033[0m = running   ({len(body)} shown)")
        ordered = pinned + body
        if show_closed:
            if cbody:
                print(f"\n\033[1;34m🌙 closed\033[0m \033[2m({len(cbody)})\033[0m")
                ordered += print_grouped(cbody, ago, start=len(ordered), w_agent=w_agent)
            else:
                print("\n\033[1;34m🌙 closed\033[0m \033[2m(none)\033[0m")
        save_json(LAST, [{"n": i, "id": r["id"], "proj": r["proj"], "cwd": r["cwd"]}
                         for i, r in enumerate(ordered, 1)])

        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return                  # piped / agent: print the listing, never prompt
        tag = f" \033[33m/{filt}\033[0m" if filt else ""
        try:
            pick = input(f"\nResume # or id{tag}  (/words=search, m=+100 more, c=closed, Enter=quit): ").strip()
        except (EOFError, KeyboardInterrupt):
            print(); return
        if not pick:
            return
        if pick.lower() == "m":
            take(100); continue
        if pick.lower() == "c":
            show_closed = not show_closed; continue
        if pick.lower() == "s" or pick.startswith("/"):
            q = pick[1:]
            if pick.lower() == "s":
                try:
                    q = input("search words (empty=clear): ")
                except (EOFError, KeyboardInterrupt):
                    print(); return
            filt = q.strip().lower() or None
            rows[:] = []          # rescan from the top under the new filter
            fiter = iter(files)
            take(limit)
            continue
        r = ordered[int(pick) - 1] if pick.isdigit() and 0 < int(pick) <= len(ordered) else None
        if not r and re.fullmatch(r"[0-9a-fA-F-]{3,36}", pick):      # short id, as the statusline shows it
            f = find_file(pick.lower())
            r = row_for(os.path.basename(f)[:-6], live, f) if f else None
        if not r:
            print("no such # or session id"); continue
        if not r["cwd"] or not os.path.isdir(r["cwd"]):
            print(f"cwd missing: {r['cwd']}"); continue
        why = claim(r["id"])
        if why:
            print(why); continue
        os.chdir(r["cwd"])
        os.execvp("claude", ["claude", "--resume", r["id"], "--dangerously-skip-permissions"])

if __name__ == "__main__":
    sys.exit(main() or 0)
